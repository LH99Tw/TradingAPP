{
  "name": "tradingapp",
  "version": "0.1.0",
  "private": true,
  "description": "TradingAPP desktop development environment (Electron + React + TypeScript)",
  "main": "./out/main/index.js",
  "author": "TradingAPP Team",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm-run-all typecheck build:app",
    "build:app": "electron-vite build",
    "typecheck": "npm-run-all typecheck:node typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "electron": "^39.8.7",
    "electron-vite": "^3.1.0",
    "npm-run-all2": "^7.0.2",
    "typescript": "^5.8.3",
    "vite": "^6.4.2"
  }
}
